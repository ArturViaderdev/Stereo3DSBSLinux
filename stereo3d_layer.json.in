{
  "file_format_version": "1.2.0",
  "layer": {
    "name": "VK_LAYER_STEREO3D_sbs",
    "type": "GLOBAL",
    "library_path": "@LIB@",
    "api_version": "1.3.275",
    "implementation_version": "1",
    "description": "Real stereoscopic 3D (geometry) for Proton/DXVK/VKD3D and Vulkan games: SBS glasses, 3D TVs, lenticular 3D monitors",
    "functions": {
      "vkGetInstanceProcAddr": "stereo3d_GetInstanceProcAddr",
      "vkGetDeviceProcAddr": "stereo3d_GetDeviceProcAddr",
      "vkNegotiateLoaderLayerInterfaceVersion": "stereo3d_NegotiateLoaderLayerInterfaceVersion"
    },
    "enable_environment": { "ENABLE_STEREO3D": "1" },
    "disable_environment": { "DISABLE_STEREO3D": "1" }
  }
}
