# stereo3d - configuracion por defecto (~/.config/stereo3d/default.conf)
# Cada juego guarda su propio perfil en ~/.config/stereo3d/<Juego.exe>.conf con Ctrl+Shift+F9.
# Los perfiles se recargan solos si los editas con el juego abierto.
# Cualquier clave se puede forzar con una variable STEREO3D_<CLAVE>, p. ej. STEREO3D_MODE=alternate.

# Desplazamiento de cada ojo en el infinito (1.0 = media pantalla). Mas alto = mas profundidad.
# 0.010-0.020 es comodo en gafas SBS (Rokid Air...).
separation = 0.015

# Profundidad (en unidades del juego) que queda en el plano de la pantalla.
# Lo que este mas cerca "sale" de la pantalla. Depende mucho del motor:
# metros (Unity, la mayoria): 1-3 | Unreal Engine (centimetros): 100-300
convergence = 1.5

# Invertir ojos si la profundidad se ve "al reves" (Ctrl+Shift+F7)
swap_eyes = 0

# 1 = 3D, 0 = misma imagen en los dos ojos (Ctrl+Shift+F8)
stereo = 1

# ---- salida ------------------------------------------------------------------------
# Que recibe la pantalla:
#  auto  = SBS completo en gafas 32:9 (3840x1080) y half SBS en el resto (por defecto)
#  full  = SBS completo: cada ojo media pantalla a resolucion completa (gafas Rokid, XREAL, VITURE)
#  half  = half SBS: cada ojo aplastado en media pantalla; la tele/monitor 3D lo estira
#  weave = monitores 3D lenticulares (Acer SpatialLabs View, Samsung Odyssey 3D): cada
#          subpixel con el ojo al que lo manda la lente. Necesita la calibracion (weave.conf).
output = auto

# auto = si la pantalla es 32:9 el juego ve la mitad de ancho (un ojo, 16:9) | 0 | 1
half_width = auto

# Ventana propia a pantalla completa en las gafas / el monitor 3D:
# auto = en SBS completo si la ventana del juego no cubre las gafas, y siempre en weave | 1 | 0
own_window = auto

# ---- weave (monitores 3D lenticulares) -----------------------------------------------
# La calibracion del monitor se guarda aparte en ~/.config/stereo3d/weave.conf (Ctrl+Shift+F9
# con el patron de prueba). Se ajusta a ojo con el patron Ctrl+Shift+F10 (ojo izq. rojo,
# ojo der. cian): F3/F4 paso, F5/F6 inclinacion, Insert/Supr fase, Fin orden RGB/BGR.
# ancho de cada lente en pixeles | desplazamiento horizontal de la lente por fila (pixeles) |
# fase (0..1) | cada subpixel R, G, B con su propia posicion (1) | panel B, G, R (1) |
# mezcla entre vistas (0 = corte limpio .. 0.25)
#weave_pitch = 6.0
#weave_slant = 0.3333
#weave_offset = 0.0
#weave_subpixel = 1
#weave_bgr = 0
#weave_soft = 0
# Encender la lente del monitor por su puerto serie USB al empezar (auto) y apagarla al salir.
# 0 = nunca (enciendela tu con tools/spatial-lens on)
lens = auto

# ---- modo de 3D --------------------------------------------------------------------
#  replay    = cada fotograma del juego se dibuja dos veces (un ojo cada vez). Un juego
#              a 60 fps da 60 fps por ojo y los dos ojos ven el mismo instante. (por defecto)
#  alternate = un fotograma para cada ojo; el juego necesita ir a 120 fps para 60 por ojo.
#  depth     = un fotograma normal del juego -> los dos ojos, reconstruidos con el buffer de
#              profundidad. Para juegos limitados a 60 fps que no admiten replay (60 por ojo).
#  hybrid    = como alternate (un ojo real por fotograma) y el otro ojo reconstruido con la
#              profundidad; los huecos se rellenan con la ultima imagen real de ese ojo y los
#              menus sin escena 3D se ven como en alternate. Menos defectos que depth (60 por ojo).
mode = replay

# Segundos en alternate al arrancar antes de pasar a replay (intros, carga de shaders). 0 = no
replay_warmup = 8

# Pasar solo de replay a alternate si el juego lee de la GPU en cada fotograma (1/0)
auto_switch = 1

# El juego espera a la pantalla (como vsync): no dibuja pares que nunca se verian. (1/0)
game_sync = 1

# Limite extra de fps del juego (0 = sin limite; el ritmo ya lo marca la pantalla)
fps_limit = 0

# Profundidad del HUD en las mismas unidades que la convergencia. 0 = plano de la pantalla.
# Menor que la convergencia = por delante. Teclas Ctrl+Shift+F1/F2.
hud_depth = 0

# Imagenes del swapchain real: 3 = dos refrescos en cola (robusto), 2 = menos latencia
present_images = 3

# Patron de prueba (Ctrl+Shift+F10). SBS: ojo izquierdo blanco, derecho negro.
# weave: ojo izquierdo rojo, derecho cian (calibracion de la lente)
test_pattern = 0

# Lo que presenta la aplicacion: game (un juego: la capa dibuja cada ojo) |
# sbs (video lado a lado) | tab (video arriba/abajo)
input = game

# ---- grabacion de video 3D (Ctrl+Shift+F12 empieza / para) ----------------------------
# Graba SBS completo (ojo izquierdo | ojo derecho) con el sonido del escritorio, codificado
# con NVENC (HEVC) en la grafica. Necesita ffmpeg y lanzar el juego con stereo3d-run.
# Carpeta de destino (por defecto ~/Videos/stereo3d o ~/Vídeos/stereo3d)
#record_dir = ~/Vídeos/stereo3d
# Tamano de CADA ojo en el video (0 = el de cada ojo en pantalla). 1920x1080 -> video 3840x1080
record_width = 1920
record_height = 1080
record_fps = 60
# 1 = empezar a grabar al arrancar el juego
record = 0

# ---- imagen -----------------------------------------------------------------------
# Zoom: 1 = imagen completa; mayor = acerca (Ctrl+Shift+RePag/AvPag)
zoom = 1.0

# Recorte de barras negras: 0 = nunca | auto | content | center
crop = 0

# Ocultar extensiones (graphics pipeline library...) para parchear todos los shaders.
hide_extensions = 1

# 0 errores, 1 informacion, 2 detalle
log_level = 1

# ---- Unreal Engine y HUD ------------------------------------------------------------
# Sombras de Unreal Engine y pasadas que reconstruyen la posicion desde la profundidad:
# auto = corregir esos shaders en todos los juegos y no desplazar los mapas de sombras (16 bits)
# en juegos de Unreal (*-Shipping.exe) | 1 = siempre las dos cosas | 0 = nada. Ctrl+Shift+Pausa compara.
fix_shadows = auto

# depth / hybrid: separacion del HUD (experimental). Los ojos se reconstruyen con una copia de la escena
# tomada antes del HUD, y el HUD queda en el plano de la pantalla. 0 = desactivada (por defecto), 1 = activada
hud_separation = 0
# tras que dibujo en el back buffer se toma la copia: auto (empieza en 1 y prueba los siguientes) o 1..16.
# Ctrl+Shift+Bloq Despl: desactivada -> auto -> 1 ... 6 -> desactivada
hud_split = auto

# hybrid: pantallas sin escena 3D (titulo, menus, cargas) sin desplazamiento estereo (1), para juegos cuyos
# menus 2D quedan muy por detras de la pantalla (EDF 6). 0 = como el resto (por defecto)
flat_menus = 0

# Guardar todos los shaders del juego (SPIR-V) en ~/.cache/stereo3d/shaders/<juego> para
# analizarlos (stereo3d-tool shader-fix, stereo3d-shader-scan). Solo para diagnostico.
dump_shaders = 0
