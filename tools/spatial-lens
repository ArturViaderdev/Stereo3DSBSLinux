#!/bin/sh
# spatial-lens - enciende/apaga la lente 3D de monitores LeiaSR (Acer SpatialLabs View 27, ...)
# desde Linux, sin el software de Acer/Leia.
#
# El monitor expone un puerto serie USB (CDC-ACM, VID 354b, /dev/ttyACMx) y acepta
# comandos de texto terminados en \r (sacados de una captura USB en Windows):
#   SR+LENS=1  -> lente 3D encendida     SR+LENS=0 -> apagada
#   SR+LENS    -> estado (0/1)           SR+SERIAL / SR+SER4 -> numeros de serie
#
# Uso: spatial-lens on | off | status | info | raw "SR+..."
#      SPATIAL_LENS_DEV=/dev/ttyACM0 spatial-lens on   (forzar dispositivo)
set -e

find_dev() {
  [ -n "$SPATIAL_LENS_DEV" ] && { echo "$SPATIAL_LENS_DEV"; return; }
  for t in /sys/class/tty/ttyACM*; do
    [ -e "$t" ] || continue
    usb=$(readlink -f "$t/device/..")
    if [ "$(cat "$usb/idVendor" 2>/dev/null)" = "354b" ]; then
      echo "/dev/$(basename "$t")"; return
    fi
  done
  return 1
}

DEV=$(find_dev) || { echo "No encuentro el puerto serie del monitor (USB 354b:xxxx, /dev/ttyACM*)." >&2
  echo "Comprueba que el cable USB-C/USB-B del monitor va al PC: lsusb | grep -i 354b" >&2; exit 1; }
[ -w "$DEV" ] || { echo "Sin permiso para $DEV. Instala la regla udev (ver README) o: sudo usermod -aG dialout \$USER" >&2; exit 1; }

send() {   # $1 = comando sin \r ; imprime la respuesta
  stty -F "$DEV" raw -echo -echoe -echok 115200 2>/dev/null || true
  exec 3<>"$DEV"
  printf '%s\r' "$1" >&3
  timeout 0.4 cat <&3 | tr -d '\r' | sed '/^$/d' || true
  exec 3>&-
}

case "$1" in
  on)     send "SR+LENS=1" >/dev/null; echo "lente 3D: $(send SR+LENS | head -1)" ;;
  off)    send "SR+LENS=0" >/dev/null; echo "lente 3D: $(send SR+LENS | head -1)" ;;
  status) echo "lente 3D: $(send SR+LENS | head -1)  ($DEV)" ;;
  info)   echo "dispositivo: $DEV"; echo "lente: $(send SR+LENS | head -1)"
          echo "SERIAL: $(send SR+SERIAL | head -1)"; echo "SER4:   $(send SR+SER4 | head -1)" ;;
  raw)    send "$2" ;;
  *)      echo "uso: $0 on|off|status|info|raw \"SR+...\""; exit 1 ;;
esac
