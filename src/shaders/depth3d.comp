// 3dvisionlinux - depth mode: builds both eyes from one mono game frame and its depth buffer.
// PASS 0 (splat): every game pixel is pushed to where it lands in each eye; the nearest wins.
// PASS 1 (resolve): each eye pixel takes the colour of the game pixel that won it; holes
//                   (background uncovered by the shift) take the farther neighbour, or in hybrid
//                   mode the last real image of that eye (rendered one frame ago from that eye).
// PASS 2 (match, before PASS 0, only with HUD separation): which of the last copies of the scene
//                   (taken before the HUD) belongs to this frame: the one equal to the image outside
//                   the HUD. Games that record on several threads present frames in another order.
// Compile: glslangValidator -V --target-env vulkan1.2 -DPASS=0 depth3d.comp (see gen.sh)
#version 450
#extension GL_EXT_buffer_reference : require
layout(local_size_x = 16, local_size_y = 16) in;
layout(buffer_reference, std430, buffer_reference_align = 4) buffer U32s { uint v[]; };
layout(push_constant) uniform PC {
  U32s color;   // game image, W*H 32-bit pixels
  U32s depth;   // raw depth copies, one per scene stage (meta[25] words apart)
  U32s keys;    // 2*W*H: winner per eye pixel ((nearness+1) << 13 | centre << 12 | source x), 0 = empty
  U32s outc;    // 2*W*H: eye images
  U32s meta;    // stage s: [4s] Dw [4s+1] Dh [4s+2] format 0 f32, 1 unorm24, 2 unorm16;
                // [16+s] A, [20+s] B of its projection (float bits); [24] stages of this frame; [25] stride;
                // [26] 1 = the depth is upside down (Unity draws its scene upside down into textures)
  uint W, H;
  float a, b;   // b != 0: depth available this frame (the projections are in meta)
  float kL, kR; // per-eye shift at infinity (NDC); 0 = 2D
  float conv;   // depth (game units) on the screen plane
  float maxShift;
  U32s prev;    // hybrid: 2*W*H last real image of each eye
  uint hyb;     // hybrid: bit 0 prev of the rebuilt eye valid, bit 1 prev of the real eye valid,
                // bit 4 = the real eye (the colour image belongs to it)
  U32s stats;   // [0..3] orientation test: depth edges / edges also in the colour, normal and flipped;
                // [4] [5] HUD separation: samples / samples that are HUD
                // [8..10] samples equal to each copy, [11] samples, [12..14] samples where each copy
                // equals one of the two previous frames' images (this frame, PASS 2)
                // [16] frames a copy matched, [17] still frames (accumulated, read by the host)
  U32s snap;    // copies of the game's back buffer before the HUD (the scene alone), snapStride words apart
  uint snapFlags;  // 1 copies available, 2 red / blue swapped, 4 copies are 10-bit (A2B10G10R10 / A2R10G10B10)
  uint snapStride;
  uint snapMask;   // which copy slots hold a recent copy
} pc;

// colour unchanged (per 8-bit channel) between this frame and the previous real image of the same eye
bool Same(uint a, uint b) {
  uvec4 d = uvec4(abs(ivec4(unpackUnorm4x8(a) * 255.0) - ivec4(unpackUnorm4x8(b) * 255.0)));
  return max(max(d.x, d.y), max(d.z, d.w)) <= 6u;
}

float DepthAt(uint stage, uint idx, uint fmt) {
  uint base = stage * pc.meta.v[25];
  if (fmt == 2u) {
    uint word = pc.depth.v[base + (idx >> 1)];
    return float((idx & 1u) != 0u ? (word >> 16) : (word & 0xFFFFu)) / 65535.0;
  }
  if (fmt == 1u) return float(pc.depth.v[base + idx] & 0xFFFFFFu) / 16777215.0;
  return uintBitsToFloat(pc.depth.v[base + idx]);
}

// 1/w of the game pixel (x, y), no dilation (0 if there is no depth). The scene can be drawn in
// stages that clear the depth (several cameras): the latest stage that drew something at this
// pixel is what the pixel shows; each stage converts its depth with its own projection.
// A depth with another shape than the game image is the scene shown centred with black bars
// (e.g. 16:10 in 16:9); flip = the depth rows are upside down.
float InvWFlip(uint x, uint y, uint flip) {
  if (pc.b == 0.0) return 0.0;
  uint mask = pc.meta.v[24];
  for (int s = 3; s >= 0; --s) {
    if ((mask & (1u << uint(s))) == 0u) continue;
    uint Dw = pc.meta.v[4 * s], Dh = pc.meta.v[4 * s + 1], fmt = pc.meta.v[4 * s + 2];
    if (Dw == 0u || Dh == 0u) continue;
    float ad = float(Dw) / float(Dh), ai = float(pc.W) / float(pc.H);
    float rx0 = 0.0, ry0 = 0.0, rw = float(pc.W), rh = float(pc.H);
    if (abs(ad / ai - 1.0) > 0.01) {
      if (ad < ai) { rw = float(pc.H) * ad; rx0 = (float(pc.W) - rw) * 0.5; }
      else { rh = float(pc.W) / ad; ry0 = (float(pc.H) - rh) * 0.5; }
    }
    float u = (float(x) + 0.5 - rx0) / rw, v = (float(y) + 0.5 - ry0) / rh;
    if (u < 0.0 || u >= 1.0 || v < 0.0 || v >= 1.0) return 1.0 / max(pc.conv, 1.0e-6);  // black bars: screen plane
    if (flip != 0u) v = 1.0 - v;
    uint idx = min(uint(v * float(Dh)), Dh - 1u) * Dw + min(uint(u * float(Dw)), Dw - 1u);
    float z = DepthAt(uint(s), idx, fmt);
    if (z <= 0.0 || z >= 1.0) continue;  // cleared here (normal or reversed depth): an earlier stage
    float iw = (z - uintBitsToFloat(pc.meta.v[16 + s])) / uintBitsToFloat(pc.meta.v[20 + s]);
    if (iw > 0.0) return min(iw, 1.0e30);
  }
  return 0.0;
}
float InvWAt(uint x, uint y) { return InvWFlip(x, y, pc.meta.v[26]); }

// width of the scene on screen (between black bars): the game's NDC spans it, so shifts scale with it
float SceneWidth() {
  uint mask = pc.meta.v[24];
  for (int s = 3; s >= 0; --s) {
    if ((mask & (1u << uint(s))) == 0u || pc.meta.v[4 * s + 1] == 0u) continue;
    float ad = float(pc.meta.v[4 * s]) / float(pc.meta.v[4 * s + 1]), ai = float(pc.W) / float(pc.H);
    return (abs(ad / ai - 1.0) > 0.01 && ad < ai) ? float(pc.H) * ad : float(pc.W);
  }
  return float(pc.W);
}

uint Diff(uint a, uint b) {
  uvec4 d = uvec4(abs(ivec4(unpackUnorm4x8(a) * 255.0) - ivec4(unpackUnorm4x8(b) * 255.0)));
  return max(max(d.x, d.y), max(d.z, d.w));
}

uint SnapIn(uint slot, uint i) {
  uint c = pc.snap.v[slot * pc.snapStride + i];
  if ((pc.snapFlags & 4u) != 0u) {  // 10 bits per channel -> 8 (as the presented image has it)
    uvec3 t = (uvec3(c, c >> 10, c >> 20) & 1023u) * 255u + 511u;
    t /= 1023u;
    c = 0xFF000000u | t.x | (t.y << 8) | (t.z << 16);
  }
  if ((pc.snapFlags & 2u) != 0u) c = (c & 0xFF00FF00u) | ((c & 0xFFu) << 16) | ((c >> 16) & 0xFFu);
  return c;
}
#if PASS != 2
// the copy of this frame: the one most of the image matches (counted by PASS 2), -1 if none does
int Slot() {
  if ((pc.snapFlags & 1u) == 0u) return -1;
  uint n = pc.stats.v[11], best = 0u;
  int s = -1;
  for (uint k = 0u; k < 3u; ++k) {
    if ((pc.snapMask & (1u << k)) == 0u) continue;
    uint m = pc.stats.v[8u + k];
    // hybrid: a copy identical to an earlier frame's finished image holds that frame's HUD (taken too
    // early, before the scene arrived: the back buffer still had the last frame)
    if ((pc.hyb & 1u) != 0u && pc.stats.v[12u + k] * 200u >= n * 199u) continue;
    if (m > best) { best = m; s = int(k); }
  }
  return (n > 0u && best * 20u >= n * 11u) ? s : -1;  // 55%: the rest may be HUD
}
// a copy is identical to this image: nothing was drawn after it, or the image did not change (it
// tells nothing about where the copy is taken)
bool StillMatch() {
  uint n = pc.stats.v[11];
  for (uint k = 0u; k < 3u; ++k)
    if ((pc.snapMask & (1u << k)) != 0u && n > 0u && pc.stats.v[8u + k] * 200u >= n * 199u) return true;
  return false;
}
int gSlot = -1;
uint SnapAt(uint i) { return SnapIn(uint(gSlot), i); }
// drawn after the scene was copied: HUD, crosshair, markers, menus
// (the copy and the presented image are the same bytes except where something was drawn after the copy)
bool HudAt(uint i) { return gSlot >= 0 && Diff(SnapAt(i), pc.color.v[i]) > 2u; }
// the colour the eyes are rebuilt from: the scene without HUD when available
uint SrcAt(uint i) { return gSlot >= 0 ? SnapAt(i) : pc.color.v[i]; }
#endif

float Luma(uint c) { vec4 v = unpackUnorm4x8(c); return dot(v.rgb, vec3(0.3, 0.59, 0.11)); }

#if PASS == 1
// A HUD pixel: f = what the game shows, s = the scene there before the HUD, r = the scene this eye
// sees there (rebuilt). Translucent panels (a darkening or a whitening over the scene) let the scene
// through: keep the panel but show this eye's scene through it, as f = s*t (+ white*(1-t)); opaque
// HUD (any other colour change) stays as it is. (Taking f as it is would show the scene behind the
// panels at the screen depth: rectangles of scene that do not move with it.)
uint HudOver(uint f, uint s, uint r) {
  vec3 F = unpackUnorm4x8(f).rgb, S = unpackUnorm4x8(s).rgb, R = unpackUnorm4x8(r).rgb;
  float lf = dot(F, vec3(0.3, 0.59, 0.11)), ls = dot(S, vec3(0.3, 0.59, 0.11));
  float t;
  vec3 model;
  if (lf <= ls) {
    t = lf / max(ls, 1.0e-4);
    model = S * t;
  } else {
    t = 1.0 - (lf - ls) / max(1.0 - ls, 1.0e-4);
    model = vec3(1.0) - (vec3(1.0) - S) * t;
  }
  t = clamp(t, 0.0, 1.0);
  vec3 err = abs(F - model);
  if (max(max(err.r, err.g), err.b) > 0.12) return f;  // another colour: opaque HUD (a slight tint is a panel)
  vec3 o = clamp(F + (R - S) * t, 0.0, 1.0);
  return packUnorm4x8(vec4(o, 1.0));
}
#endif

void main() {
#if PASS == 2
  // one invocation per sample of a 16-pixel grid
  uint x = gl_GlobalInvocationID.x * 16u + 8u, y = gl_GlobalInvocationID.y * 16u + 8u;
  if (x >= pc.W || y >= pc.H) return;
  uint i = y * pc.W + x, c = pc.color.v[i];
  // the previous frames' images: in hybrid, the last real image of each eye (frames N-1 and N-2)
  uint realE = (pc.hyb >> 4) & 1u, p = pc.prev.v[(1u - realE) * pc.W * pc.H + i];
  uint q = (pc.hyb & 2u) != 0u ? pc.prev.v[realE * pc.W * pc.H + i] : p;
  atomicAdd(pc.stats.v[11], 1u);
  for (uint k = 0u; k < 3u; ++k) {
    if ((pc.snapMask & (1u << k)) == 0u) continue;
    uint sk = SnapIn(k, i);
    if (Diff(sk, c) <= 2u) atomicAdd(pc.stats.v[8u + k], 1u);
    if ((pc.hyb & 1u) != 0u && (Diff(sk, p) <= 2u || Diff(sk, q) <= 2u)) atomicAdd(pc.stats.v[12u + k], 1u);
  }
#else
  uint x = gl_GlobalInvocationID.x, y = gl_GlobalInvocationID.y;
  if (x >= pc.W || y >= pc.H) return;
  uint WH = pc.W * pc.H;
  gSlot = Slot();
#if PASS == 0
  bool have = pc.b != 0.0;
  if (x == 0u && y == 0u && (pc.snapFlags & 1u) != 0u) {
    if (gSlot >= 0) atomicAdd(pc.stats.v[16], 1u);
    else if (StillMatch()) atomicAdd(pc.stats.v[17], 1u);
  }
  if (have && gSlot >= 0 && (x & 7u) == 0u && (y & 7u) == 0u) {
    atomicAdd(pc.stats.v[4], 1u);
    if (HudAt(y * pc.W + x)) atomicAdd(pc.stats.v[5], 1u);
  }
  // orientation test on a sparse grid: do the depth edges match the colour edges as is, or upside down?
  if (have && (x & 7u) == 0u && (y & 7u) == 0u && x + 3u < pc.W) {
    bool colEdge = abs(Luma(pc.color.v[y * pc.W + x]) - Luma(pc.color.v[y * pc.W + x + 3u])) > 0.09;
    for (uint h = 0u; h < 2u; ++h) {
      float a = InvWFlip(x, y, h), b = InvWFlip(x + 3u, y, h);
      bool dEdge = (a > 0.0 || b > 0.0) && max(a, b) > 1.25 * min(a, b);
      if (dEdge) {
        atomicAdd(pc.stats.v[2u * h], 1u);
        if (colEdge) atomicAdd(pc.stats.v[2u * h + 1u], 1u);
      }
    }
  }
  float invW = 0.0;
  if (have) {
    // nearest of five neighbours: edge pixels (blends of object and background from antialiasing,
    // TAA or scaling) move with the object instead of being left behind as a halo
    for (int o = -2; o <= 2; ++o) invW = max(invW, InvWAt(uint(clamp(int(x) + o, 0, int(pc.W) - 1)), y));
  }
  float base = 1.0 - pc.conv * invW;
  float sceneW = have ? SceneWidth() : float(pc.W);
  uint key = (((floatBitsToUint(invW) >> 12) + 1u) << 13) | x;
  for (uint e = 0u; e < 2u; ++e) {
    float k = e == 0u ? pc.kL : pc.kR;
    float shift = have ? clamp(k * base * sceneW * 0.5, -pc.maxShift, pc.maxShift) : 0.0;
    // the pixel goes to the two eye pixels around its shifted position (no cracks where the image
    // stretches); the one that holds its centre has priority, so there is no half-pixel bias
    // (hybrid mode alternates real and rebuilt images in each eye: a bias would shimmer)
    int i0 = int(floor(float(x) + shift));
    int ic = int(floor(float(x) + 0.5 + shift));
    for (int j = 0; j < 2; ++j) {
      int xi = i0 + j;
      uint kk = key | (xi == ic ? 4096u : 0u);
      if (xi >= 0 && xi < int(pc.W)) atomicMax(pc.keys.v[e * WH + y * pc.W + uint(xi)], kk);
    }
  }
#else
  if (pc.maxShift < 0.0) {  // debug (NV3D_DEPTH_SHOW=1): both eyes show the rebuilt distance as grey
    float iw = InvWAt(x, y);
    float d = iw > 0.0 ? 1.0 / (1.0 + pc.conv * iw) : 1.0;  // near dark, far light, convergence = mid grey
    uint g = uint(clamp(d, 0.0, 1.0) * 255.0);
    pc.outc.v[y * pc.W + x] = 0xFF000000u | (g << 16) | (g << 8) | g;
    pc.outc.v[WH + y * pc.W + x] = 0xFF000000u | (g << 16) | (g << 8) | g;
    return;
  }
  // hybrid: what did not move on screen since the last real image of the real eye (HUD, text,
  // the player followed by the camera, a still scene) is taken from the last real image of the
  // rebuilt eye instead of being rebuilt: each eye alternates real and rebuilt images, and
  // anything the depth places wrongly (no depth: HUD; other depth ranges) would jump between them
  uint realE = (pc.hyb >> 4) & 1u;
  bool still = false;
  if ((pc.hyb & 3u) == 3u) {
    still = true;
    for (int o = -1; o <= 1 && still; ++o) {
      uint xx = uint(clamp(int(x) + o, 0, int(pc.W) - 1));
      still = Same(pc.color.v[y * pc.W + xx], pc.prev.v[realE * WH + y * pc.W + xx]);
    }
  }
  for (uint e = 0u; e < 2u; ++e) {
    uint row = e * WH + y * pc.W;
    if (still && e != realE) {
      pc.outc.v[row + x] = pc.prev.v[row + x];
      continue;
    }
    bool hud = HudAt(y * pc.W + x) && (pc.hyb == 0u || e != realE);
    uint key = pc.keys.v[row + x];
    uint sx = x;
    if (key == 0u && (pc.hyb & 1u) != 0u) {
      // hybrid: the uncovered background was really seen by this eye one frame ago
      pc.outc.v[row + x] = hud ? pc.color.v[y * pc.W + x] : pc.prev.v[row + x];
      continue;
    }
    if (key == 0u) {
      // A hole: background uncovered next to a nearer object that moved. The real content is not
      // in the image; continue the background by mirroring it across the edge (keeps its texture,
      // unlike repeating one pixel, which draws streaks), skipping the blended edge pixels.
      uint kl = 0u, kr = 0u, rl = 0u, rr = 0u;
      for (uint r = 1u; r <= 96u && kl == 0u && r <= x; ++r) { kl = pc.keys.v[row + x - r]; rl = r; }
      for (uint r = 1u; r <= 96u && kr == 0u && x + r < pc.W; ++r) { kr = pc.keys.v[row + x + r]; rr = r; }
      bool left = kl != 0u && (kr == 0u || (kl >> 13) < (kr >> 13));
      uint k2 = left ? kl : kr;
      if (k2 != 0u) {
        int edge = int(k2 & 0xFFFu);
        int near = left ? edge - 2 : edge + 2;
        int cand = left ? near - int(rl) : near + int(rr);
        near = clamp(near, 0, int(pc.W) - 1);
        cand = clamp(cand, 0, int(pc.W) - 1);
        // the mirrored pixel must be background too, not another near object
        float bg = uintBitsToFloat(((k2 >> 13) - 1u) << 12);
        float iw = InvWAt(uint(cand), y);
        sx = uint(iw > bg * 1.15 + 1.0e-6 ? near : cand);
      }
    } else {
      sx = key & 0xFFFu;
    }
    uint c = SrcAt(y * pc.W + sx);
    if (hud) {  // HUD: on the screen plane, in both eyes
      pc.outc.v[row + x] = HudOver(pc.color.v[y * pc.W + x], SnapAt(y * pc.W + x), c);
      continue;
    }
    if (gSlot < 0 && (pc.hyb & 1u) != 0u && e != realE && sx != x) {
      // HUD, crosshair, markers, menus are drawn after the scene and are not in the depth: they
      // belong on the screen plane. Evidence: the last real image of this eye. If the pixel left
      // where it is matches it much better than the rebuilt one, it is screen-plane content.
      // (strict, and the neighbours must agree: a pixel-by-pixel choice in textured areas mixes two
      // positions: dotted text, objects that look translucent)
      uint ref = pc.prev.v[row + x], z = pc.color.v[y * pc.W + x];
      uint dZ = Diff(z, ref);
      uint xl = x > 0u ? x - 1u : x, xr = min(x + 1u, pc.W - 1u);
      uint agree = (dZ <= 6u ? 1u : 0u) +
                   (Diff(pc.color.v[y * pc.W + xl], pc.prev.v[e * WH + y * pc.W + xl]) <= 6u ? 1u : 0u) +
                   (Diff(pc.color.v[y * pc.W + xr], pc.prev.v[e * WH + y * pc.W + xr]) <= 6u ? 1u : 0u);
      if (agree == 3u && Diff(c, ref) > dZ + 40u) c = z;
    }
    pc.outc.v[row + x] = c;
  }
#endif
#endif
}
